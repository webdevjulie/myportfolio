<script type="module">
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initSkills() {
    const section = document.querySelector("#skills");
    if (!section) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // Detect touch/coarse-pointer devices (phones, tablets) — the tilt
    // effect depends on continuous mousemove, which doesn't fire the same
    // way on touch, and can leave a card stuck mid-tilt after a tap.
    const isTouchDevice = window.matchMedia("(hover: none), (pointer: coarse)").matches;

    const heading = section.querySelector(".skills-heading");
    const cards = section.querySelectorAll(".skill-card");

    if (!cards.length) {
      console.error("Skills: no .skill-card elements found.");
      return;
    }

    // ---- 3D tilt-on-hover, follows the mouse. Skipped entirely on
    // touch devices so cards don't get stuck tilted after a tap. ----
    if (!isTouchDevice) {
      cards.forEach((card) => {
        const quickRotX = gsap.quickTo(card, "rotationX", { duration: 0.4, ease: "power2.out" });
        const quickRotY = gsap.quickTo(card, "rotationY", { duration: 0.4, ease: "power2.out" });

        card.style.perspective = "600px";

        card.addEventListener("mousemove", (e) => {
          const rect = card.getBoundingClientRect();
          const px = (e.clientX - rect.left) / rect.width;   // 0 -> 1
          const py = (e.clientY - rect.top) / rect.height;   // 0 -> 1

          quickRotY((px - 0.5) * 22);   // tilt left/right
          quickRotX(-(py - 0.5) * 22);  // tilt up/down

          card.style.setProperty("--glint-x", `${px * 100}%`);
          card.style.setProperty("--glint-y", `${py * 100}%`);
          card.classList.add("tilting");
        });

        card.addEventListener("mouseleave", () => {
          quickRotX(0);
          quickRotY(0);
          card.classList.remove("tilting");
        });
      });
    }

    if (prefersReducedMotion) {
      return; // skip entrance animation, cards remain visible as-is
    }

    // ---- Entrance: glass "materialize" — cards condense in from blur,
    // random scatter of scale/rotation/blur so it doesn't feel like a
    // generic uniform fade-up ----
    if (heading) {
      gsap.from(heading, {
        y: 24,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: heading,
          start: "top 90%",
          toggleActions: "play none none reverse",
        },
      });
    }

    const rows = section.querySelectorAll(".flex.flex-wrap.justify-center");

    rows.forEach((row) => {
      const rowCards = row.querySelectorAll(".skill-card");
      if (!rowCards.length) return;

      gsap.fromTo(
        rowCards,
        {
          opacity: 0,
          scale: 0.6,
          rotation: () => gsap.utils.random(-14, 14),
          filter: "blur(6px)",
        },
        {
          opacity: 1,
          scale: 1,
          rotation: 0,
          filter: "blur(0px)",
          duration: 0.7,
          ease: "back.out(1.6)", // slight overshoot — feels more "snap into place" than a soft fade
          stagger: {
            each: 0.07,
            from: "random", // pops in random order, not left-to-right — less predictable
          },
          scrollTrigger: {
            trigger: row,
            start: "top 92%",
            toggleActions: "play none none reverse",
          },
        }
      );
    });

    // Failsafe: if ScrollTrigger somehow never fires for a row (e.g. it's
    // already in view before the observer attaches on some mobile browsers),
    // force everything visible after a short delay so nothing stays hidden.
    setTimeout(() => {
      cards.forEach((card) => {
        gsap.set(card, { clearProps: "opacity,filter,scale,rotation" });
      });
    }, 3000);
  }

  if (document.readyState === "complete") {
    initSkills();
  } else {
    window.addEventListener("load", initSkills);
  }
  document.addEventListener("astro:page-load", initSkills);
</script>