<style>
  .dark-blue { background: #0a0e1a; }

  /* iPhone-style glass card */
  .glass-card {
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    border: 1px solid rgba(255, 255, 255, 0.5);
    border-radius: 22px;
    box-shadow:
      0 8px 32px rgba(0, 0, 0, 0.2),
      inset 0 1px 1px rgba(255, 255, 255, 0.6),
      inset 0 -1px 1px rgba(255, 255, 255, 0.1);
    position: relative;
    overflow: hidden;
    transform-style: preserve-3d;
    will-change: transform;
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .glass-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(
      to bottom,
      rgba(255, 255, 255, 0.35),
      rgba(255, 255, 255, 0) 100%
    );
    border-radius: 22px 22px 0 0;
    pointer-events: none;
  }

  /* Roving specular glint that follows the tilt */
  .glass-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at var(--glint-x, 50%) var(--glint-y, 0%),
      rgba(34, 211, 238, 0.35),
      transparent 55%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .glass-card:hover::after {
    opacity: 1;
  }

  .glass-card.tilting {
    box-shadow:
      0 20px 45px rgba(34, 211, 238, 0.35),
      inset 0 1px 1px rgba(255, 255, 255, 0.7),
      inset 0 -1px 1px rgba(255, 255, 255, 0.15);
    background: rgba(255, 255, 255, 0.35);
  }

  /* Video background */
  .video-bg-section {
    position: relative;
    overflow: hidden;
  }

  .video-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  .video-bg-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(10, 14, 26, 0.72);
    z-index: 1;
  }

  .video-bg-section > .content-layer {
    position: relative;
    z-index: 2;
  }

  /* Responsive skill-card sizing: smaller on phones, scaling up
     through tablet and desktop, so 8-per-row doesn't get cramped */
  .skill-card {
    width: 5.5rem;
    height: 5.5rem;
  }

  .skill-card img {
    width: 2.25rem;
    height: 2.25rem;
  }

  .skill-card p {
    font-size: 0.65rem;
  }

  @media (min-width: 480px) {
    .skill-card {
      width: 6.5rem;
      height: 6.5rem;
    }
    .skill-card img {
      width: 2.75rem;
      height: 2.75rem;
    }
    .skill-card p {
      font-size: 0.7rem;
    }
  }

  @media (min-width: 640px) {
    .skill-card {
      width: 7rem;
      height: 7rem;
    }
    .skill-card img {
      width: 3rem;
      height: 3rem;
    }
    .skill-card p {
      font-size: 0.75rem;
    }
  }
</style>

