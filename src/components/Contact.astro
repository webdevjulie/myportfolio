</section>

<script type="module">
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  function initContact() {
    const section = document.querySelector("#contact");
    if (!section) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    const heading = section.querySelector(".contact-heading");
    const left = section.querySelector(".contact-left");
    const right = section.querySelector(".contact-right");
    const rows = section.querySelectorAll(".contact-row");

    if (!left || !right) {
      console.error("Contact: left/right panels not found.");
      return;
    }

    if (prefersReducedMotion) {
      return;
    }

    if (heading) {
      gsap.from(heading, {
        y: 24,
        opacity: 0,
        duration: 0.8,
        ease: "power3.out",
        scrollTrigger: {
          trigger: heading,
          start: "top 90%",
          toggleActions: "play none none reverse",
        },
      });
    }

    // Left info card slides in from the left, right form slides in from the right —
    // they "meet in the middle"
    gsap.from(left, {
      x: -50,
      opacity: 0,
      duration: 0.8,
      ease: "power2.out",
      scrollTrigger: {
        trigger: left,
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
    });

    gsap.from(right, {
      x: 50,
      opacity: 0,
      duration: 0.8,
      ease: "power2.out",
      scrollTrigger: {
        trigger: right,
        start: "top 85%",
        toggleActions: "play none none reverse",
      },
    });

    // Individual contact rows (email, phone, location) stagger in slightly after the card
    if (rows.length) {
      gsap.from(rows, {
        y: 12,
        opacity: 0,
        duration: 0.5,
        ease: "power2.out",
        stagger: 0.1,
        delay: 0.2,
        scrollTrigger: {
          trigger: left,
          start: "top 85%",
          toggleActions: "play none none reverse",
        },
      });
    }
  }

  if (document.readyState === "complete") {
    initContact();
  } else {
    window.addEventListener("load", initContact);
  }
  document.addEventListener("astro:page-load", initContact);
</script>