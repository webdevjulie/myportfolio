    }

    .reveal.reveal-init.reveal-left {
      opacity: 0;
      transform: translateX(-60px);
    }

    .reveal.reveal-init.reveal-right {
      opacity: 0;
      transform: translateX(60px);
    }

    .reveal.reveal-init.reveal-pop {
      opacity: 0;
      transform: scale(0.85);
    }

    .reveal.reveal-init:not(.reveal-left):not(.reveal-right):not(.reveal-pop) {
      opacity: 0;
      transform: translateY(24px);
    }

    .reveal.reveal-visible {
      opacity: 1 !important;
      transform: none !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal.reveal-init {
        transition: none;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
