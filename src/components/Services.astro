  <style>
    /* Default: fully visible. JS only ADDS the hidden starting state
       right before observing, so if JS fails to load, content still shows. */
    .reveal {
      opacity: 1;
      transform: none;
    }

    .reveal.reveal-init {
      transition: opacity 0.8s ease, transform 0.8s ease;
    }

    .reveal.reveal-init.reveal-left {
      opacity: 0;
      transform: translateX(-60px);
    }

    .reveal.reveal-init.reveal-right {
      opacity: 0;
      transform: translateX(60px);
    }

    .reveal.reveal-init.reveal-pop {
      opacity: 0;
      transform: scale(0.85);
    }

    .reveal.reveal-init:not(.reveal-left):not(.reveal-right):not(.reveal-pop) {
      opacity: 0;
      transform: translateY(24px);
    }

    .reveal.reveal-visible {
      opacity: 1 !important;
      transform: none !important;
    }

    @media (prefers-reduced-motion: reduce) {
      .reveal.reveal-init {
        transition: none;
        opacity: 1 !important;
        transform: none !important;
      }
    }
  </style>
</section>

<script type="module">
  function initServices() {
    const section = document.querySelector("#services");
    if (!section) return;

    const reveals = section.querySelectorAll(".reveal");
    if (!reveals.length) return;

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // If motion is reduced, or IntersectionObserver isn't supported,
    // just leave everything visible (default CSS state) — no animation.
    if (prefersReducedMotion || !("IntersectionObserver" in window)) {
      return;
    }

    // Arm the hidden starting state only once JS confirms it can animate.
    reveals.forEach((el) => el.classList.add("reveal-init"));

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("reveal-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      {
        threshold: 0.15,
        rootMargin: "0px 0px -10% 0px",
      }
    );

    reveals.forEach((el) => observer.observe(el));

    // Failsafe: in case an element never intersects (e.g. it's already
    // fully in view above the observer's first check on some browsers),
    // force everything visible after a short delay.
    setTimeout(() => {
      reveals.forEach((el) => el.classList.add("reveal-visible"));
    }, 2500);
  }

  if (document.readyState === "complete") {
    initServices();
  } else {
    window.addEventListener("load", initServices);
  }
  document.addEventListener("astro:page-load", initServices);
</script>