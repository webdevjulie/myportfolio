<section
  id="home"
  class="relative min-h-[100dvh] flex items-center overflow-hidden px-4 sm:px-6 py-24 sm:py-20 bg-black overflow-visible"
>
  <div class="relative z-10 mx-auto grid w-full max-w-7xl grid-cols-1 items-center gap-y-10 lg:grid-cols-[1fr_auto_1fr] lg:gap-y-0">

    <!-- LEFT TEXT -->
    <div class="text-center lg:text-left order-1 z-20">
      <p class="hero-greeting mb-2 sm:mb-3 text-blue-400 text-sm sm:text-base md:text-lg uppercase tracking-[0.25em] sm:tracking-[0.3em]">
        Hello!
      </p>

      <h1 class="hero-title text-4xl sm:text-5xl md:text-6xl font-extrabold leading-tight text-white">
        <span class="hero-title-line1"></span>
        <span class="hero-title-line2 block text-blue-400"></span>
      </h1>
    </div>

    <!-- IMAGE (pulsing) -->
    <div class="order-2 z-10 -my-6 sm:-my-10 lg:-my-16 flex justify-center lg:col-start-2">
      <div class="relative">
        <!-- Glow (tibok) -->
        <div class="hero-glow absolute inset-0 -z-10 rounded-full bg-blue-500/30 blur-[80px] sm:blur-[100px] lg:blur-[120px] scale-125 sm:scale-140 lg:scale-150"></div>

        <div class="hero-image relative">
          <img
            src={`${import.meta.env.BASE_URL}profile.png`}
            alt="Julie Anne"
            class="hero-pic h-[20rem] sm:h-[28rem] md:h-[32rem] lg:h-[44rem] w-auto object-contain relative z-10 fade-bottom"
          />
        </div>
      </div>
    </div>

    <style>
      .fade-bottom {
        -webkit-mask-image: linear-gradient(to bottom, black 92%, transparent 100%);
        mask-image: linear-gradient(to bottom, black 92%, transparent 100%);
      }

      /* Blinking cursor for typing effect */
      .hero-title.typing::after {
        content: "|";
        display: inline-block;
        margin-left: 2px;
        color: #60a5fa; /* text-blue-400 */
        animation: blink 0.8s step-end infinite;
      }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }

      /* "Tibok" heartbeat pulse for the glow behind the photo */
      .hero-glow {
        animation: tibok-glow 2.6s ease-in-out infinite;
        transform-origin: center;
      }

      @keyframes tibok-glow {
        0%, 100% { transform: scale(1.25); opacity: 0.75; }
        50% { transform: scale(1.38); opacity: 1; }
      }

      @media (min-width: 1024px) {
        @keyframes tibok-glow {
          0%, 100% { transform: scale(1.5); opacity: 0.75; }
          50% { transform: scale(1.65); opacity: 1; }
        }
      }

      /* Subtle "tibok" scale on the photo itself, like a heartbeat */
      .hero-pic {
        animation: tibok-pic 2.6s ease-in-out infinite;
        transform-origin: center bottom;
      }

      @keyframes tibok-pic {
        0%, 100% { transform: scale(1); }
        50% { transform: scale(1.02); }
      }

      /* Gentle floating letters once revealed */
      .hero-letter {
        display: inline-block;
        will-change: transform;
      }

      /* Push page content up on mobile/tablet so the fixed bottom bar
         doesn't cover anything below the hero */
      @media (max-width: 1023px) {
        #home {
          padding-bottom: 6.5rem;
        }
      }

      /* Respect users who prefer reduced motion: turn off all custom motion */
      @media (prefers-reduced-motion: reduce) {
        .hero-title.typing::after {
          animation: none;
          opacity: 1;
        }
        .hero-glow,
        .hero-pic,
        .hero-letter {
          animation: none !important;
          transform: none !important;
        }
      }
    </style>

    <!-- RIGHT TEXT -->
    <div class="hero-content text-center lg:text-right order-3 z-20 lg:col-start-3 px-2 sm:px-0">
      <h2 class="hero-subtitle text-3xl sm:text-4xl md:text-5xl font-extrabold text-white">
        <span class="hero-subtitle-line1"></span>
        <span class="hero-subtitle-line2 block text-blue-400"></span>
      </h2>

      <p class="mt-4 sm:mt-6 text-sm sm:text-base md:text-lg leading-7 sm:leading-8 text-slate-300">
        I build responsive websites and modern web applications with clean,
        user-friendly interfaces and reliable backend systems. I enjoy turning
        ideas into fast, functional, and visually appealing digital experiences.
      </p>
    </div>

  </div>

  <!-- SOCIAL + RESUME -->
  <!-- Mobile/tablet: fixed to the bottom of the viewport, with a subtle
       backdrop so it reads as a dedicated bar rather than floating text.
       Desktop (lg+): back to absolute, sitting inside the hero like before. -->
  <div class="fixed inset-x-0 bottom-0 z-30 flex items-center justify-center gap-3 border-t border-white/10 bg-black/70 px-4 py-4 backdrop-blur-md sm:gap-4 lg:absolute lg:inset-x-auto lg:bottom-10 lg:left-1/2 lg:z-20 lg:w-auto lg:-translate-x-1/2 lg:border-0 lg:bg-transparent lg:px-0 lg:py-0 lg:backdrop-blur-none">
    <!-- LinkedIn -->
    <a
      href="https://www.linkedin.com/in/julie-anne-de-los-reyes-7281b72b4"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="LinkedIn"
      class="glass-button flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center rounded-xl sm:rounded-2xl border border-white/10 text-white hover:-translate-y-1 hover:border-blue-400 hover:text-blue-400 transition"
    >
      <svg class="h-5 w-5 sm:h-6 sm:w-6" viewBox="0 0 24 24" fill="currentColor">
        <path d="M6.94 8.5A1.56 1.56 0 1 0 6.94 5.38a1.56 1.56 0 0 0 0 3.12ZM5.5 9.5h2.88V18H5.5zM10.5 9.5h2.76v1.16h.04c.38-.72 1.31-1.48 2.7-1.48 2.88 0 3.41 1.89 3.41 4.35V18H16.5v-7.68c0-1.83-.03-4.18-2.55-4.18-2.55 0-2.94 1.99-2.94 4.04V18H10.5z"/>
      </svg>
    </a>

    <!-- Email -->
    <a
      href="mailto:delosreyesjulieanne199@gmail.com"
      aria-label="Email"
      class="glass-button flex h-12 w-12 sm:h-14 sm:w-14 items-center justify-center rounded-xl sm:rounded-2xl border border-white/10 text-white hover:-translate-y-1 hover:border-blue-400 hover:text-blue-400 transition"
    >
      <svg
        class="h-5 w-5 sm:h-6 sm:w-6"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path d="M4 6h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1Z"/>
        <path d="m5 8 7 5 7-5"/>
      </svg>
    </a>

    <!-- Resume -->
    <a
      href={`${import.meta.env.BASE_URL}DELOSREYES-CV.pdf`}
      target="_blank"
      class="glass-button flex items-center gap-2 sm:gap-3 rounded-xl sm:rounded-2xl border border-blue-400 px-4 py-3 sm:px-6 sm:py-4 text-xs sm:text-sm font-bold uppercase tracking-[0.2em] sm:tracking-[0.25em] text-white hover:bg-blue-500/20 transition"
    >
      RESUME
      <svg
        class="h-4 w-4 sm:h-5 sm:w-5"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <path d="M14 2H7a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7z"/>
        <path d="M14 2v5h5"/>
      </svg>
    </a>
  </div>
</section>

<script type="module">
  import Lenis from "lenis";
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  import { TextPlugin } from "gsap/TextPlugin";

  gsap.registerPlugin(ScrollTrigger, TextPlugin);

  function wrapLetters(el, text) {
    el.innerHTML = "";
    const frag = document.createDocumentFragment();
    text.split("").forEach((char) => {
      const span = document.createElement("span");
      span.className = "hero-letter";
      span.textContent = char === " " ? "\u00A0" : char;
      frag.appendChild(span);
    });
    el.appendChild(frag);
    return el.querySelectorAll(".hero-letter");
  }

  function floatLetters(letters) {
    letters.forEach((letter, i) => {
      gsap.to(letter, {
        y: -6,
        duration: 1.6 + Math.random() * 0.8,
        ease: "sine.inOut",
        repeat: -1,
        yoyo: true,
        delay: i * 0.05,
      });
    });
  }

  function initHero() {
    const greeting = document.querySelector(".hero-greeting");
    const titleEl = document.querySelector(".hero-title");
    const line1 = document.querySelector(".hero-title-line1");
    const line2 = document.querySelector(".hero-title-line2");
    const content = document.querySelector(".hero-content");
    const subLine1 = document.querySelector(".hero-subtitle-line1");
    const subLine2 = document.querySelector(".hero-subtitle-line2");

    if (!greeting || !titleEl || !line1 || !line2 || !content || !subLine1 || !subLine2) {
      console.error("Hero: one or more text elements not found in DOM yet.");
      return;
    }

    const prefersReducedMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    let lenis = null;
    if (!prefersReducedMotion) {
      lenis = new Lenis({
        duration: 1.2,
        smoothWheel: true,
      });

      lenis.on("scroll", ScrollTrigger.update);

      gsap.ticker.add((time) => {
        lenis.raf(time * 1000);
      });

      gsap.ticker.lagSmoothing(0);
    }

    if (prefersReducedMotion) {
      line1.textContent = "I'm";
      line2.textContent = "Julie Anne";
      subLine1.textContent = "Full Stack";
      subLine2.textContent = "Developer";
      gsap.set([greeting, content], { opacity: 1, x: 0, y: 0 });
      return;
    }

    subLine1.textContent = "Full Stack";
    subLine2.textContent = "Developer";
    const subLetters = [
      ...wrapLetters(subLine1, "Full Stack"),
      ...wrapLetters(subLine2, "Developer"),
    ];
    gsap.set(subLetters, { opacity: 0, y: 20 });

    titleEl.classList.add("typing");

    const tl = gsap.timeline({ delay: 0.3 });

    tl.from(greeting, {
      y: 30,
      opacity: 0,
      duration: 0.6,
      ease: "power2.out",
    })
      .to(line1, {
        duration: 0.5,
        text: "I'm",
        ease: "none",
      })
      .to(line2, {
        duration: 1,
        text: "Julie Anne",
        ease: "none",
      })
      .call(() => {
        titleEl.classList.remove("typing");
        const line1Letters = wrapLetters(line1, "I'm");
        const line2Letters = wrapLetters(line2, "Julie Anne");
        floatLetters([...line1Letters, ...line2Letters]);
      })
      .from(
        content,
        {
          x: 60,
          opacity: 0,
          duration: 0.8,
          ease: "power2.out",
        },
        "-=0.3"
      )
      .to(
        subLetters,
        {
          opacity: 1,
          y: 0,
          duration: 0.4,
          stagger: 0.04,
          ease: "power2.out",
          onComplete: () => floatLetters(subLetters),
        },
        "-=0.5"
      );
  }

  if (document.readyState === "complete") {
    initHero();
  } else {
    window.addEventListener("load", initHero);
  }
  document.addEventListener("astro:page-load", initHero);
</script>